/webapp/sql/dump.sql.bz2
/benchmarker/userdata/img.zip
/benchmarker/userdata/img/
/benchmarker/bin/
/webapp/golang/app
/webapp/sql/*.part
/benchmarker/userdata/*.part
/benchmarker/userdata/.img-ready
